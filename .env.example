# Copy to `.env` (gitignored) and edit. Every key here is read by `server` at startup
# (see server/src/main/kotlin/com/afnaihisab/server/config/AppConfig.kt).
#
# Precedence: a real environment variable wins over this file, so CI and deployed environments
# set variables and never ship a `.env` (ADR-0015). Never commit real secrets — not here, not
# anywhere else in the repo.

# development | test | production
APP_ENV=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Phase 0 default: file-backed H2 in PostgreSQL compatibility mode, so the stack runs with no
# Docker install (docs/TOOLING.md). The database file lands in ./.data/ at the repo root.
# To switch to real Postgres, change this one line, e.g.:
#   DATABASE_URL=jdbc:postgresql://localhost:5432/afnaihisab
DATABASE_URL=jdbc:h2:file:./.data/afnaihisab;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;AUTO_SERVER=TRUE
DATABASE_USER=sa
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=5

# Explicit allow-list, comma-separated, full origins including scheme — never a wildcard
# (ADR-0015). Phase 2 replaces the localhost entry with the deployed web origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Phase 1, not read yet ---
# JWT signing key for the access/refresh token pair (ADR-0008). Generate a random value per
# environment; never reuse the dev key anywhere real.
# JWT_SECRET=

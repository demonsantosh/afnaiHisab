# Copy to `web/.env.local` (gitignored) if you need to override anything.
#
# `NEXT_PUBLIC_` is not a secret marker — the opposite: Next.js inlines these values into the
# browser bundle. Never put a secret here; server-only secrets belong in the repo-root `.env`
# read by `server` (ADR-0015).

# Origin of the Ktor backend. Defaults to http://localhost:8080 when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

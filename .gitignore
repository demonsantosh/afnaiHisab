# --- Secrets (ADR-0015) ---
# `.env` is never committed; `.env.example` is, and documents every key.
.env
.env.*
!.env.example

# --- Gradle / JVM ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!src/**/build/
local.properties
*.hprof
.kotlin/

# --- Local database (H2 file store, docs/TOOLING.md) ---
.data/
*.db
*.mv.db
*.trace.db

# --- Node / Next.js ---
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
# NOTE: package-lock.json is deliberately NOT ignored — ADR-0017 pins dependencies and requires
# the lockfile to be committed.

# --- IDE / editor ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp

# --- Android / iOS (Phase 3/4) ---
.cxx/
captures/
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# --- OS noise ---
.DS_Store
Thumbs.db

# Playwright MCP scratch output (docs/WORKFLOW.md — manual browser checks)
.playwright-mcp/
